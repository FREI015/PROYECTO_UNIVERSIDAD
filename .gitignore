.DS_Store
Thumbs.db
desktop.ini

# Logs y temporales
*.log
*.tmp
*.temp
*.old
*.orig

# Entorno local
.env
.env.*
!.env.example

# Dependencias / caches
vendor/
node_modules/
.cache/
tmp/
temp/

# IDE / editores
.vscode/
.idea/

# Base de datos local o generada
*.sqlite
*.sqlite3
*.db

# IMPORTANTE:
# No ignorar los scripts SQL del proyecto.
# sql/bd.sql debe poder versionarse.
!sql/
!sql/*.sql

# Comprimidos
*.zip
*.rar
*.7z

# Backups manuales
*.bak
*.bak_*
*.bak-*
*.backup

# Reportes temporales generados por reparaciones
reporte_*.txt
*_whatsapp_*.txt

# Carpetas locales de reparacion / respaldo
_backups_locales/
_reportes_reparacion/

# Fixes temporales
_fixes/

# Archivos subidos por usuarios / datos generados
uploads/empleados/*
!uploads/empleados/.gitkeep
# Backups locales de base de datos
backups/
# Auditorias locales generadas durante revision senior
_auditoria_senior/
# Conexion local con credenciales reales
includes/conexion.php
# Credenciales temporales en texto plano
credenciales.txt
# Respaldos locales
# Mantener ejemplo de conexion versionable
!conexion.example.php
# Permitir archivos de seguridad dentro de uploads
!uploads/.htaccess
!uploads/empleados/.htaccess

# Seguridad: no versionar volcados con datos reales
sql/control_asistencia_completa.sql

# Herramientas locales de prueba
pruebas_generacion.php

# Limpieza profesional
_auditoria_senior/
docs/AUDITORIA_LIMPIEZA/
docs/LIMPIEZA_FINAL_*/
