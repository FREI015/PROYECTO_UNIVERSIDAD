Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^includes(?:/|$) - [F,L,NC]
RewriteRule ^sql(?:/|$) - [F,L,NC]
RewriteRule ^backups(?:/|$) - [F,L,NC]
RewriteRule ^_auditoria_senior(?:/|$) - [F,L,NC]
RewriteRule ^\.git(?:/|$) - [F,L,NC]
RewriteRule ^\.env(?:\.|$) - [F,L,NC]
</IfModule>

<FilesMatch "^(conexion\.example\.php|pruebas_generacion\.php|\.gitignore|\.gitattributes)$">
Require all denied
</FilesMatch>

<FilesMatch "\.(sql|bak|backup|log|ini)$">
Require all denied
</FilesMatch>