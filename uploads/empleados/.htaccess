Options -Indexes

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phar|cgi|pl|py|rb|sh|bat|cmd|exe|dll|asp|aspx|jsp)$">
    Require all denied
</FilesMatch>

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py .rb .sh .bat .cmd .exe .dll .asp .aspx .jsp
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py .rb .sh .bat .cmd .exe .dll .asp .aspx .jsp
